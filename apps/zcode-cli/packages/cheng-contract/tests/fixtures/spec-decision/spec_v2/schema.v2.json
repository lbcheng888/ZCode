{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "csg.spec.v2",
 "title": "CSG spec v2（requirement / module / assertion / link）",
 "description": "机器可读真相源；图/表只是投影。本 schema 允许 canonical 19 题之外的 unknown/negative 任务标签与 task_index >= 0；canonical 19 集合仍由 data/spec_v2/index.json（19 条、固定顺序）和 data/spec_v2/gate_check.py 严格固定，不把 unknown 计入 19。校验器实现本文件用到的 JSON-Schema 子集（required/type/const/enum/pattern/items/properties/additionalProperties/minItems/minLength/$ref）。断言对象禁止出现 expected 字段：期望值只能来自 oracle 的 cases/props 文件。",
 "type": "object",
 "required": ["schema", "task", "task_index", "title", "source", "flags", "requirements", "modules", "assertions", "links"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "csg.spec.v2"},
  "task": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
  "task_index": {"type": "integer", "minimum": 0},
  "title": {"type": "string", "minLength": 1},
  "source": {"$ref": "#/$defs/source"},
  "flags": {"$ref": "#/$defs/flags"},
  "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
  "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}},
  "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
  "links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/link"}},
  "notes": {"type": "string"}
 },
 "$defs": {
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "source": {
   "type": "object",
   "required": ["path", "lines", "sha256", "quote"],
   "additionalProperties": false,
   "properties": {
    "path": {"type": "string", "minLength": 1},
    "lines": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
    "sha256": {"$ref": "#/$defs/sha256"},
    "quote": {"type": "string", "minLength": 1}
   }
  },
  "flags": {
   "type": "object",
   "required": ["template_assisted", "missing"],
   "additionalProperties": false,
   "properties": {
    "template_assisted": {"type": "boolean"},
    "template_reason": {"type": "string"},
    "missing": {"type": "array", "items": {"type": "string"}}
   }
  },
  "requirement": {
   "type": "object",
   "required": ["id", "task", "fn", "kind", "text", "signature", "domain", "source", "status"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^req\\.[a-z0-9_]+\\.[A-Za-z0-9_]+$"},
    "task": {"type": "string"},
    "fn": {"type": "string"},
    "kind": {"type": "string", "enum": ["behavior", "edge", "interface", "invariant"]},
    "text": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "status": {"type": "string", "enum": ["covered", "missing"]},
    "notes": {"type": "string"}
   }
  },
  "interface": {
   "type": "object",
   "required": ["signature", "params", "returns"],
   "additionalProperties": false,
   "properties": {
    "signature": {"type": "string", "minLength": 1},
    "params": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
       "name": {"type": "string", "minLength": 1},
       "type": {"type": "string", "minLength": 1}
      }
     }
    },
    "returns": {"type": "string", "minLength": 1}
   }
  },
  "module": {
   "type": "object",
   "required": ["id", "task", "name", "role", "fn", "interface", "impl", "status"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^mod\\.[a-z0-9_]+(\\.[A-Za-z0-9_]+)+$"},
    "task": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "role": {"type": "string", "enum": ["entry", "helper"]},
    "fn": {"type": "string"},
    "interface": {"$ref": "#/$defs/interface"},
    "impl": {
     "type": "object",
     "required": ["kind", "path", "sha256", "symbol", "result_path", "result_sha256", "result_verdict"],
     "additionalProperties": false,
     "properties": {
      "kind": {"type": "string", "enum": ["compose_fn", "compose_selected", "compose_task", "decomp_gen", "decomp_compose", "settle_prog", "reference_prog"]},
      "path": {"type": "string", "minLength": 1},
      "sha256": {"$ref": "#/$defs/sha256"},
      "symbol": {"type": "string", "minLength": 1},
      "result_path": {"type": "string", "minLength": 1},
      "result_sha256": {"$ref": "#/$defs/sha256"},
      "result_verdict": {"type": "string", "minLength": 1},
      "plan": {"type": "array", "items": {"type": "string", "minLength": 1}}
     }
    },
    "status": {"type": "string", "enum": ["evidenced", "missing"]},
    "notes": {"type": "string"}
   }
  },
  "assertion": {
   "type": "object",
   "required": ["id", "task", "fn", "kind", "requirement_ids", "module_ids", "oracle", "evidence", "status", "flags"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^ast\\.[a-z0-9_]+\\.[A-Za-z0-9_]+\\.[a-z][a-z0-9_]*$"},
    "task": {"type": "string"},
    "fn": {"type": "string"},
    "kind": {"type": "string", "enum": ["eval", "property"]},
    "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "module_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "oracle": {
     "type": "object",
     "required": ["path", "sha256", "tier", "rows"],
     "additionalProperties": false,
     "properties": {
      "path": {"type": "string", "minLength": 1},
      "sha256": {"$ref": "#/$defs/sha256"},
      "tier": {"type": "string", "enum": ["eval", "property"]},
      "rows": {"type": "integer", "minimum": 1}
     }
    },
    "evidence": {
     "type": "object",
     "description": "执行证据口径：receipt 是执行回执（compose/decomp 的 result.json 或 oracle_settle 的 detail TSV），不是逐行 eval 回执；rows_passed 是 oracle 行中经逐行执行核对通过的行数。compose/decomp 族的行级证据 = 组合体程序的逐行 if 检查 + result.json 聚合计数；仓库内 heldout.json/task_result.json 的 eval_pass 是 eval 通过候选数（候选级），不是 oracle 行数，故不作为 rows_passed 的来源。",
     "required": ["kind", "program", "receipt", "rows_total", "rows_passed", "checks_total", "checks_passed", "extra_checks", "verdict"],
     "additionalProperties": false,
     "properties": {
      "kind": {"type": "string", "enum": ["compose", "decomp_compose", "settle_eval"], "description": "compose=组合体逐行检查口径；decomp_compose=decomp 组合体逐行检查口径；settle_eval=oracle_settle detail TSV 逐行口径。三者都不是逐行 eval 回执。"},
      "program": {
       "type": "object",
       "required": ["path", "sha256"],
       "additionalProperties": false,
       "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
       }
      },
      "receipt": {
       "type": "object",
       "description": "执行回执：compose/decomp result.json 或 oracle_settle detail TSV；不含逐行 eval 明细。",
       "required": ["path", "sha256"],
       "additionalProperties": false,
       "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
       }
      },
      "table": {
       "type": "object",
       "required": ["path", "sha256"],
       "additionalProperties": false,
       "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
       }
      },
      "rows_total": {"type": "integer", "minimum": 1},
      "rows_passed": {"type": "integer", "minimum": 0, "description": "oracle 行中实际执行并通过的行数；settle 由 detail TSV 逐行核对，compose/decomp 由 gate 解析组合体逐行检查并与回执聚合计数交叉核对。"},
      "checks_total": {"type": "integer", "minimum": 1},
      "checks_passed": {"type": "integer", "minimum": 0},
      "extra_checks": {"type": "integer", "minimum": 0},
      "verdict": {"type": "string", "minLength": 1}
     }
    },
    "status": {"type": "string", "enum": ["pass", "missing"]},
    "flags": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
   }
  },
  "link": {
   "type": "object",
   "required": ["id", "from", "to", "type"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^lnk\\.[a-z0-9_]+\\.[0-9]{3}$"},
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["implemented_by", "verified_by", "exercises", "composes"]}
   }
  }
 }
}
