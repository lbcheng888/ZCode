    { "path": "./packages/debug" },
    { "path": "./packages/debug/tsconfig.server.json" },
    { "path": "./packages/dynamic-workflow" },
    { "path": "./packages/dynamic-workflow-runtime" },
    { "path": "./packages/i18n" },
    { "path": "./packages/ios-simulator-plugin" },
    { "path": "./packages/node-repl-host" },
    { "path": "./packages/office-runtime" },
    { "path": "./packages/shared-types" },
    { "path": "./packages/swift-bridge" },
