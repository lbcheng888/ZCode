      "id": "v4-todo-panel-title",
      "description": "E2E_TODO_SEED 首发的 case-local 标题生成响应。",
      "metadata": {
        "kind": "common",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "E2E_TODO_SEED 首发会触发默认 title sidecar；固定 case-local 标题响应，避免回放 500，并用该首发 marker 隔离跨 case 匹配。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": [
          "Generate a concise title",
          "E2E_TODO_SEED"
        ]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "v4-todo-panel-title",
          "inputTokens": 64,
          "outputTokens": 8,
          "text": "{\"title\":\"Todo Panel E2E\"}"
        }
      }
    },
    {
